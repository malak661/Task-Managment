NODE_ENV=development
PORT=4000

# Local mongo from docker-compose, or an Atlas connection string
MONGODB_URI=mongodb://localhost:27017/task-board

# Where the React app runs — used for the CORS allow list
CLIENT_ORIGIN=http://localhost:5173

# Anything long and random. Do not reuse the value below outside local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional, tests only. Left unset, `npm test` starts its own in-memory mongo.
# Set it to reuse a mongo you already have running — the database name must end
# in "-test", because the suite empties it between tests.
# MONGODB_TEST_URI=mongodb://localhost:27017/task-board-test
